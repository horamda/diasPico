# =============================================================
# CONFIGURACIÓN LOCAL — copiar a .env y completar los valores
# Para Railway: configurar cada variable en el panel Variables
# =============================================================

# ── Base de datos PostgreSQL (Railway) ───────────────────────
# LOCAL: pegar el valor de DATABASE_PUBLIC_URL del servicio Postgres
# RAILWAY: usar Variable Reference → ${{Postgres.DATABASE_URL}}
# La app acepta DATABASE_URL y RAILWAY_URL. En Railway preferir DATABASE_URL.
DATABASE_URL=postgresql://postgres:PASSWORD@postgres.railway.internal:5432/railway
RAILWAY_URL=${DATABASE_URL}

# ── Base de datos MySQL (servidor externo) ───────────────────
MYSQL_HOST=190.210.132.63
MYSQL_USER=tu_usuario_mysql
MYSQL_PASSWORD=tu_password_mysql
MYSQL_DB=tu_base_de_datos_mysql

# ── Flask ────────────────────────────────────────────────────
# Valores: development | production
FLASK_ENV=production
# Generá uno aleatorio con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=reemplazar-con-string-aleatorio-largo

# ── API externa (control-asistencia backend) ─────────────────
EXTERNAL_API_BASE_URL=https://control-asistencia.up.railway.app
EXTERNAL_API_KEY=tu-api-key-segura
EXTERNAL_API_TIMEOUT=20

# ── Google Sheets ────────────────────────────────────────────
# Separar múltiples URLs con punto y coma (;)
SHEETS_TIMEOUT=30
DOTACION_ENTREGA_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vTRrt57z-QDSRmDblvUV6AHs_Q1og0qgW0Ec-fp1L0QjLr8R_346nhHEkKsndqka-wQUdKSc2-3PizX/pub?output=csv&gid=0;https://docs.google.com/spreadsheets/d/e/2PACX-1vTRrt57z-QDSRmDblvUV6AHs_Q1og0qgW0Ec-fp1L0QjLr8R_346nhHEkKsndqka-wQUdKSc2-3PizX/pub?output=csv&gid=249846040
DOTACION_RECARGAS_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vTRrt57z-QDSRmDblvUV6AHs_Q1og0qgW0Ec-fp1L0QjLr8R_346nhHEkKsndqka-wQUdKSc2-3PizX/pub?output=csv&gid=1883083406;https://docs.google.com/spreadsheets/d/e/2PACX-1vTRrt57z-QDSRmDblvUV6AHs_Q1og0qgW0Ec-fp1L0QjLr8R_346nhHEkKsndqka-wQUdKSc2-3PizX/pub?output=csv&gid=680588527

# Frescura ERP Chess
# Login real al ERP para consultar stock de frescura por deposito.
# El mapeo 1:1,4:2 normaliza el deposito 4 del ERP al id interno 2 (Dolores).
FRESCURA_API_BASE_URL=https://delpalacio.chesserp.com/AR459/web/api/chess/v1
FRESCURA_API_USER=tu_usuario_api
FRESCURA_API_PASSWORD=tu_password_api
FRESCURA_API_DEPOSITOS=1,4
FRESCURA_API_DEPOSIT_MAP=1:1,4:2
FRESCURA_API_TIMEOUT=60

# Fallback legacy opcional, si alguna instalacion aun usa el conector anterior.
# FRESCURA_API_URL=
# FRESCURA_API_TOKEN=
# FRESCURA_API_PATH=/api/frescura/articulos
