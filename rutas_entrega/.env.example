# Base de datos (Railway te da DATABASE_URL). Si tu app ya usa SQLALCHEMY_DATABASE_URI, el módulo la reutiliza.
DATABASE_URL=postgresql://usuario:password@host:5432/base

# ChessERP
CHESS_BASE_URL=https://delpalacio.chesserp.com/AR459/web/api/chess/v1
CHESS_USER=
CHESS_PASSWORD=
# Ajustar a lo que usa tu MCP de ChessERP (ver README, sección ChessERP)
CHESS_LOGIN_PATH=/auth/login
CHESS_CLIENTES_PATH=/clientes/
CHESS_SUCURSALES=2

# Token simple para disparar la sync por HTTP (cron de Railway). Vacío = deshabilitado.
RUTAS_SYNC_TOKEN=
